; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Token Runner: Ship Before Reset"
config/description="A strategic adventure about vibe-coding your dream app before the token reset."
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/textures/icon.png"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
ResourceManager="*res://scripts/autoload/resource_manager.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
DreamAppManager="*res://scripts/autoload/dream_app_manager.gd"
EventManager="*res://scripts/autoload/event_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
AchievementManager="*res://scripts/autoload/achievement_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
UIManager="*res://scripts/autoload/ui_manager.gd"
CycleManager="*res://scripts/autoload/cycle_manager.gd"
ModelManager="*res://scripts/autoload/model_manager.gd"
AgentManager="*res://scripts/autoload/agent_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

