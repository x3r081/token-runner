      "description": "Sure. Why not. What could go wrong?",
      "region": "localhost",
      "prerequisites": ["production_down"],
      "objectives": [
        {"id": "upgrade_app", "type": "interact", "target": "dream_app_terminal", "count": 1, "text": "Prepare the Dream App for shipping"},
        {"id": "visit_vault", "type": "visit", "target": "token_vault", "count": 1, "text": "Claim the Token Vault reserves"},
        {"id": "ship", "type": "interact", "target": "deploy_button", "count": 1, "text": "Hit Deploy"}
      ],
      "rewards": {"tokens": 2000, "reputation": 100, "achievement": "ship_it"},
      "giver": "roommate_ai"
    },
    "fix_without_touching": {
      "name": "Fix It Without Touching Anything",
      "description": "Management has forbidden code changes. Good luck.",
      "region": "dependency_district",
      "prerequisites": ["install_node"],
      "objectives": [
        {"id": "defeat_bug", "type": "defeat", "target": "null_reference", "count": 5, "text": "Defeat 5 Null References without dying"}
      ],
      "rewards": {"tokens": 250, "will_to_live": -5, "reputation": 10}
    },
    "junior_agent": {
      "name": "The Junior Agent Deleted The Database",
      "description": "Escort the agent to safety. Try not to let it 'optimize' anything else.",
