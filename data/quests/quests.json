      "auto_start": true,
      "objectives": [
        {"id": "talk_roommate", "type": "talk", "target": "roommate_ai", "count": 1, "text": "Talk to your AI roommate"},
        {"id": "collect_tokens", "type": "collect_tokens", "target": "any", "count": 10, "text": "Collect 10 tokens from your apartment"}
      ],
      "rewards": {"tokens": 50, "coffee": 1},
      "giver": "roommate_ai"
    },
    "tiny_change": {
      "name": "Just One Tiny Change",
      "description": "The client wants the button green. Should take 2 seconds. Check the laptop (client email) and see it through.",
      "region": "localhost",
      "prerequisites": ["hello_localhost"],
      "objectives": [
        {"id": "answer_email", "type": "story", "target": "tiny_change", "count": 1, "text": "Answer the client's 'tiny' email (check the laptop)"}
